# .env file template
# Copy this file to .env and fill in the values

# ── Core ────────────────────────────────────────────────────────
# Secret key for JWT signing (MUST be at least 32 characters)
secret_key=your-super-secret-key-min-32-chars-here-change-this
# Database URL (PostgreSQL with asyncpg)
database_url=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_chat
# Environment: development or production
environment=development

# ── Server ──────────────────────────────────────────────────────
host=0.0.0.0
port=8000
workers=4
log_level=info

# ── Auth ────────────────────────────────────────────────────────
# Enable/disable user registration
enable_signup=true
# Token expiry settings
access_token_expire_minutes=10080
refresh_token_expire_days=30
bcrypt_cost_factor=12
# CORS allowed origins (JSON array format)
allowed_cors_origins=["*"]

# ── Embedding ──────────────────────────────────────────────────
embedding_engine=openai
rag_embedding_model=text-embedding-3-small
embedding_dimension=1536

# ── OpenAI / API Configuration ─────────────────────────────────
# For OpenAI-compatible APIs
openai_api_key=sk-your-openai-api-key-here
openai_base_url=https://api.openai.com/v1

# ── RAG ─────────────────────────────────────────────────────────
chunk_size=1500
chunk_overlap=100
rag_top_k=5
rag_relevance_threshold=0.3
enable_rag_query_generation=true
enable_rag_reranking=false

# ── Web Search ──────────────────────────────────────────────────
enable_web_search=false
enable_web_search_auto=false
web_search_engine=duckduckgo
search_result_count=5
enable_web_content_extraction=true

# Search API Keys (uncomment and set if using Brave/Tavily/SearXNG)
# brave_search_api_key=your-brave-api-key
# tavily_api_key=your-tavily-api-key
# searxng_query_url=http://localhost:8080/search

# ── File Storage ────────────────────────────────────────────────
storage_provider=local
upload_dir=/app/uploads
# AWS S3 settings (if using S3 storage)
# aws_s3_bucket_name=your-bucket
# aws_access_key_id=your-aws-key
# aws_secret_access_key=your-aws-secret
# aws_region=ap-southeast-1

# ── Task Model ──────────────────────────────────────────────────
task_model=
enable_title_generation=true
enable_tag_generation=true

# ── Features ────────────────────────────────────────────────────
enable_image_generation=false
enable_code_interpreter=false
enable_memory=false

# ── Redis (optional, for caching & task queue) ─────────────────
# redis_url=redis://localhost:6379/0

# ── Monitoring ──────────────────────────────────────────────────
enable_metrics=true
sentry_dsn=
