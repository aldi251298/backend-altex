# .env file template
# Copy this file to .env and fill in the values
# Required variables are marked with [REQUIRED]

# ═══════════════════════════════════════════════════════════════════════════
# CORE CONFIGURATION [REQUIRED]
# ═══════════════════════════════════════════════════════════════════════════

# Secret key for JWT signing (MUST be at least 32 characters)
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
secret_key=your-super-secret-key-min-32-chars-here-change-this

# Database URL (PostgreSQL with asyncpg) [REQUIRED]
# Format: postgresql+asyncpg://user:password@host:port/database
database_url=postgresql+asyncpg://postgres:uLFIfDIzxzTuxLbNBdNn@altex-chat.crek440ck7co.ap-northeast-1.rds.amazonaws.com:5432/altex-chat

# Environment: development, staging, or production
environment=production

# ═══════════════════════════════════════════════════════════════════════════
# SERVER CONFIGURATION
# ═══════════════════════════════════════════════════════════════════════════

host=0.0.0.0
port=8000
workers=4
log_level=info

# ═══════════════════════════════════════════════════════════════════════════
# AUTHENTICATION
# ═══════════════════════════════════════════════════════════════════════════

# Enable/disable user registration
enable_signup=true

# Token expiry settings
access_token_expire_minutes=10080
refresh_token_expire_days=30
bcrypt_cost_factor=12

# CORS allowed origins (JSON array format)
allowed_cors_origins=["*"]

# ═══════════════════════════════════════════════════════════════════════════
# ADMIN CREDENTIALS (for initial setup)
# These are used by deploy.sh to create the default admin user
# ═══════════════════════════════════════════════════════════════════════════

admin_email=admin@altex.local
admin_password=Admin@123456

# ── Embedding ──────────────────────────────────────────────────
embedding_engine=ollama
rag_embedding_model=nomic-embed-text
embedding_dimension=768

# ── OpenAI / API Configuration ─────────────────────────────────
# For OpenAI-compatible APIs (vLLM compatible)
openai_api_key=fake-key-because-vllm-doesnt-verify
openai_base_url=http://172.31.11.139:8000/v1

# ── RAG ─────────────────────────────────────────────────────────
chunk_size=1500
chunk_overlap=100
rag_top_k=5
rag_relevance_threshold=0.3
enable_rag_query_generation=false
enable_rag_reranking=false

# ── Web Search ──────────────────────────────────────────────────
enable_web_search=true
enable_web_search_auto=false
web_search_engine=tavily
search_result_count=5
enable_web_content_extraction=true

# Search API Keys
brave_search_api_key=
tavily_api_key=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
searxng_query_url=

# ── File Storage ────────────────────────────────────────────────
storage_provider=local
upload_dir=/app/uploads
# AWS S3 settings (if using S3 storage)
# aws_s3_bucket_name=your-bucket
# aws_access_key_id=your-aws-key
# aws_secret_access_key=your-aws-secret
# aws_region=ap-southeast-1

# ── Task Model ──────────────────────────────────────────────────
task_model=
enable_title_generation=true
enable_tag_generation=true

# ── Features ────────────────────────────────────────────────────
enable_image_generation=false
enable_code_interpreter=false
enable_memory=false

# ── Redis (optional, for caching & task queue) ─────────────────
# redis_url=redis://localhost:6379/0

# ── Monitoring ──────────────────────────────────────────────────
enable_metrics=true
sentry_dsn=
